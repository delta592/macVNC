 void rfbssl_destroy(rfbClientPtr cl)
 {
     struct rfbssl_ctx *ctx = (struct rfbssl_ctx *)cl->sslctx;
+
+    if (!ctx)
+	return;
+    ssl_lock(ctx);
     if (ctx->ssl)
 	SSL_free(ctx->ssl);
+    ctx->ssl = NULL;
     if (ctx->ssl_ctx)
 	SSL_CTX_free(ctx->ssl_ctx);
+    ctx->ssl_ctx = NULL;
+    ssl_unlock(ctx);
+    if (ctx->lock_inited)
+	pthread_mutex_destroy(&ctx->lock);
+    free(ctx);
+    cl->sslctx = NULL;
 }
